# ==========================================
# 🧑💼 AI Employee Configuration
# ==========================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Security & Autonomy Guardrails
MAX_AUTONOMOUS_REFUND_AMOUNT=50.00
MAX_AUTONOMOUS_DISCOUNT_PERCENT=10.0
PROMPT_INJECTION_STRICT_MODE=true
REQUIRE_HUMAN_APPROVAL_FOR_QUOTES=true

# AI Provider Settings (Optional if using Mock Mode for local demo)
AI_PROVIDER=gemini # gemini | openai | mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# Enterprise Email Integration
EMAIL_ADAPTER_MODE=mock # mock | gmail
GMAIL_CREDENTIALS_FILE=secrets/credentials.json
GMAIL_TOKEN_FILE=secrets/token.json
SENDER_EMAIL=ai-employee@company.com

# Notion CRM Integration
CRM_ADAPTER_MODE=mock # mock | notion
NOTION_API_KEY=ntn_your_notion_integration_token
NOTION_CUSTOMERS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_DIGESTS_DB_ID=

# Storage & Caching
REDIS_URL=redis://localhost:6379/0
